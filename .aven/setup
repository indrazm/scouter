#!/usr/bin/env bash
set -euo pipefail

# Bun 1.4.4 (packageManager in package.json, CI) is expected in the image; install it if missing.
if ! command -v bun > /dev/null || [ "$(bun -v)" != "1.4.4" ]; then
  echo "installing bun 1.4.4"
  curl -fsSL https://bun.sh/install | bash -s "bun-v1.4.4" > /dev/null
  export PATH="$HOME/.bun/bin:$PATH"
fi

# Tests build real temporary git repos.
command -v git > /dev/null || { sudo apt-get update; sudo apt-get install -y --no-install-recommends git; }

echo "installing dependencies"
bun install --frozen-lockfile --ignore-scripts
