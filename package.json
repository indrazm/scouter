{
  "name": "scouter",
  "version": "0.2.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsrs --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test",
    "lint": "oxlint src tests",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@opentui/core": "0.8.2",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "tsrs": "0.21.0-ts7.1.0-beta"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": []
}
